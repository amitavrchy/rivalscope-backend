NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=
DATABASE_URL=postgresql://rivalscope:rivalscope_local@localhost:5433/rivalscope
REDIS_URL=redis://localhost:6380
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GOOGLE_CLOUD_PROJECT=
OPENAI_API_KEY=
OPENAI_MODEL=
AI_FALLBACK_PROVIDER=
TAVILY_API_KEY=
SMTP_URL=smtp://localhost:1025
MAIL_FROM=RivalScope <noreply@rivalscope.local>
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ENCRYPTION_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDINGS_ENABLED=true
AI_MAX_INPUT_CHARS=180000
AI_DAILY_TOKEN_LIMIT=500000
# Set pricing only after confirming the selected model's actual rates; otherwise cost is unknown.
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=
BILLING_PROVIDER=stripe
MOCK_BILLING_WEBHOOK_SECRET=
REPORT_FONT_PATH=
OTEL_SERVICE_NAME=rivalscope
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

BILLING_GRACE_DAYS=3

RUN_MIGRATIONS=false
SEED_ON_START=false
ALLOW_PRODUCTION_SEED=false
